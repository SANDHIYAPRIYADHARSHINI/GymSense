rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function goal(value) { return value in ['weight-gain', 'weight-loss', 'custom']; }
    function bounded(value, maximum) { return value is number && value >= 0 && value <= maximum; }
    function publicFields(data, uid) {
      return data.keys().hasOnly(['uid','username','displayName','photoURL','goal'])
        && data.uid == uid && data.username is string
        && data.username.matches('^[a-z0-9_]{3,24}$')
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 80
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048)) && goal(data.goal);
    }
    function profileMatches(uid, data) {
      let profile = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      return profile.uid == data.uid && profile.username == data.username
        && profile.displayName == data.displayName && profile.goal == data.goal && profile.photoURL == data.photoURL;
    }
    function accepted(from, to) {
      return exists(/databases/$(database)/documents/friendRequests/$(from + '_' + to))
        && get(/databases/$(database)/documents/friendRequests/$(from + '_' + to)).data.status == 'accepted';
    }
    // Private profiles are never searchable/readable by another user: Firestore cannot redact fields.
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validProfile(uid)
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update: if owner(uid) && validProfile(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;
      function validProfile(uid) {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid','username','displayName','email','photoURL','goal','fitnessLevel','createdAt','updatedAt'])
          && d.uid == uid && d.email == request.auth.token.email
          && d.username.matches('^[a-z0-9_]{3,24}$')
          && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 80
          && d.photoURL == null && goal(d.goal)
          && d.fitnessLevel in ['beginner','intermediate','advanced']
          && d.createdAt is timestamp && d.updatedAt == request.time;
      }
      // Challenge membership is an owner-only preference, separate from public activity.
      match /preferences/challenges {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['joined'])
          && request.resource.data.joined is list && request.resource.data.joined.size() <= 3
          && request.resource.data.joined.hasOnly(['workouts','distance','reps']);
      }
      // Daily nutritional intake is health-related private account data.
      match /intake/{date} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['protein','fiber','water','proteinTarget','fiberTarget','waterTarget'])
          && bounded(request.resource.data.protein,100000) && bounded(request.resource.data.fiber,100000)
          && bounded(request.resource.data.water,100000) && bounded(request.resource.data.proteinTarget,100000)
          && bounded(request.resource.data.fiberTarget,100000) && bounded(request.resource.data.waterTarget,100000);
      }
    }
    // Claim and profile must be created atomically. Claims are immutable, even by their owner.
    match /usernames/{username} {
      allow get: if signedIn();
      allow create: if signedIn() && username.matches('^[a-z0-9_]{3,24}$')
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
    }
    // Only these explicit public fields are exposed for authenticated search and previews.
    match /publicProfiles/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 20;
      allow create, update: if owner(uid) && publicFields(request.resource.data,uid) && profileMatches(uid,request.resource.data);
    }
    // Detailed activity is shared only with accepted friends; email/private settings never accompany it.
    match /friendActivity/{uid} {
      allow get: if owner(uid) || (signedIn() && (accepted(uid,request.auth.uid) || accepted(request.auth.uid,uid)));
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['activity','updatedAt'])
        && request.resource.data.activity is map && request.resource.data.updatedAt == request.time
        && request.resource.data.activity == getAfter(/databases/$(database)/documents/workoutProgress/$(uid)).data.activity;
    }
    // Plans and progress are exclusively owned; clients cannot change another account's state.
    match /workoutPlans/{uid}/plans/{planGoal} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && goal(planGoal) && request.resource.data.id == planGoal
        && request.resource.data.keys().hasOnly(['id','title','description','editable','days'])
        && request.resource.data.days is list && request.resource.data.days.size() == 3;
    }
    match /workoutProgress/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['currentPlanGoal','completedDays','completedExercises','plans','activity','currentStreak','longestStreak','lastWorkoutDate','totalReps','totalActiveMinutes','updatedAt'])
        && goal(request.resource.data.currentPlanGoal)
        && request.resource.data.completedDays is list && request.resource.data.completedDays.size() <= 9
        && request.resource.data.completedExercises is map && request.resource.data.plans is map
        && request.resource.data.plans.keys().hasOnly(['weight-gain','weight-loss','custom'])
        && request.resource.data.activity is map
        && bounded(request.resource.data.currentStreak,100000) && bounded(request.resource.data.longestStreak,100000)
        && bounded(request.resource.data.totalReps,1000000000) && bounded(request.resource.data.totalActiveMinutes,1000000000)
        && (request.resource.data.lastWorkoutDate == null || request.resource.data.lastWorkoutDate is string)
        && request.resource.data.updatedAt == request.time;
    }
    match /dietPreferences/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['goal','dietType','allergies','cuisine','mealsPerDay','budget','cookingTime','updatedAt'])
        && request.resource.data.goal in ['gain muscle','lose fat','maintain']
        && request.resource.data.dietType in ['vegetarian','vegan','eggetarian','non-vegetarian','pescatarian']
        && request.resource.data.allergies is list && request.resource.data.allergies.size() <= 6
        && request.resource.data.allergies.hasOnly(['nuts','dairy','gluten','soy','eggs','shellfish'])
        && request.resource.data.cuisine in ['Indian','Mediterranean','Continental','high-protein']
        && request.resource.data.mealsPerDay in [3,4] && request.resource.data.budget in ['budget','normal','premium']
        && request.resource.data.cookingTime in ['under 15 minutes','under 30 minutes','meal prep']
        && request.resource.data.updatedAt == request.time;
    }
    // Missing-document reads permit idempotent create transactions; existing records stay owner-only.
    match /exerciseLogs/{id} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/exerciseLogs/$(id)) || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId','exerciseId','planGoal','dayId','sets','reps','durationSeconds','formScore','completedAt'])
        && request.resource.data.exerciseId is string && request.resource.data.exerciseId.size() <= 100
        && goal(request.resource.data.planGoal) && (request.resource.data.dayId == null || request.resource.data.dayId is string)
        && bounded(request.resource.data.sets,100) && request.resource.data.sets >= 1
        && bounded(request.resource.data.reps,100000) && bounded(request.resource.data.durationSeconds,86400)
        && (request.resource.data.formScore == null || bounded(request.resource.data.formScore,100))
        && request.resource.data.completedAt == request.time;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      // Logs are immutable; changes use explicit delete/new records to avoid ownership transfers.
    }
    match /runs/{id} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/runs/$(id)) || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId','type','distanceKm','durationSeconds','averagePace','steps','source','startedAt','endedAt','stepSource','distanceSource'])
        && request.resource.data.type in ['outdoor','treadmill'] && request.resource.data.source in ['gps','bluetooth','manual']
        && bounded(request.resource.data.distanceKm,1000) && bounded(request.resource.data.durationSeconds,604800)
        && bounded(request.resource.data.steps,1000000)
        && (request.resource.data.averagePace == null || bounded(request.resource.data.averagePace,10000000))
        && request.resource.data.startedAt is timestamp && request.resource.data.endedAt is timestamp
        && request.resource.data.endedAt >= request.resource.data.startedAt && request.resource.data.endedAt <= request.time
        && request.resource.data.stepSource is string && request.resource.data.distanceSource is string;
    }
    // Sender creates pending only; recipient alone accepts/declines. Either party may remove a relationship.
    match /friendRequests/{id} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/friendRequests/$(id)) || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      function validRequest() {
        let d=request.resource.data;
        return d.keys().hasOnly(['from','to','members','status','createdAt','updatedAt'])
          && d.from is string && d.to is string && d.from != d.to && id == d.from + '_' + d.to
          && d.members == [d.from,d.to] && d.createdAt is timestamp && d.updatedAt == request.time;
      }
      allow create: if signedIn() && validRequest() && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.to));
      allow update: if signedIn() && validRequest()
        && request.resource.data.from == resource.data.from && request.resource.data.to == resource.data.to
        && ((request.auth.uid == resource.data.to && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted','rejected'] && request.resource.data.createdAt == resource.data.createdAt)
          || (request.auth.uid == resource.data.from && resource.data.status == 'rejected'
          && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time));
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }
    // No wildcard grants: all unspecified collections and operations are denied.
    match /{document=**} { allow read, write: if false; }
  }
}
